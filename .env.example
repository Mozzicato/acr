# Groq powers the recovery planner and the in-app support chat. Optional: without it, both fall
# back to rule-based behaviour.
GROQ_API_KEY=

# Shared state for serverless hosting (Vercel). Add Upstash Redis from the Vercel Marketplace and
# these are set for you. Either naming works. Without them, state lives in server memory (fine for
# `npm run dev`, not for Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional. When set, resetting the bank, changing network conditions and approving recoveries
# need this key. Open the console once as https://your-app/?key=YOUR_KEY and it's remembered.
ADMIN_KEY=
